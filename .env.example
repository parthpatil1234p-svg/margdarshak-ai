# =================================================================
# 🧭 MARGDARSHAK AI (मार्गदर्शक AI) - ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Database Configuration (MongoDB Atlas)
# Leave empty or omit if you wish to use the built-in High-Speed In-Memory JSON Store (100% Offline Mode)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.rrpphau.mongodb.net/margdarshak_ai?retryWrites=true&w=majority

# 3. AI Reasoning Engine (Google Gemini API)
# Get a free API Key from: https://aistudio.google.com/
# Leave empty to automatically use the Deterministic Heuristic Fallback Engine
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Optional Frontend Origin (for strict production CORS)
FRONTEND_URL=http://localhost:5000
